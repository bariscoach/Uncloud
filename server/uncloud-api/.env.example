# Names only. Real values go in the Vercel project (Production), never in this repo.
# Restricted Stripe key (test mode now; live key at go-live)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint
STRIPE_WEBHOOK_SECRET=
# bpc_ of the customer portal configuration
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional. Default uncloud_plus_yearly
STRIPE_PRICE_LOOKUP_KEY=
# Optional. "true" turns on Stripe Tax on Checkout. Default off until registrations exist
STRIPE_AUTOMATIC_TAX=
# Supabase project URL, publishable key (public) and secret key (server only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Ed25519 private key, PKCS#8 DER, base64
ENTITLEMENT_SIGNING_KEY=
# Optional. Default https://uncloud-api.vercel.app
PUBLIC_BASE_URL=
