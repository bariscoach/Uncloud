# Names only. Real values go in the Vercel project (Production), never in this repo.
# Supabase project URL, publishable key (public) and secret key (server only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Ed25519 private key, PKCS#8 DER, base64. Signs the entitlement the app verifies.
ENTITLEMENT_SIGNING_KEY=
# Optional. Comma-separated origins allowed to post the launch list.
# Default includes https://www.tryuncloud.com, https://tryuncloud.com, and the older Vercel hosts.
WAITLIST_ALLOWED_ORIGINS=
# Ed25519 PKCS#8 private key, base64. Signs license keys. Not the test key in test/fixtures/license-key.js.
LICENSE_SIGNING_PRIVATE_KEY=
# Stripe webhook signing secret (whsec_...). Verifies Stripe-Signature on POST /v1/webhooks/payments.
STRIPE_WEBHOOK_SECRET=
# Stripe secret key, only to read Checkout line items when the event does not include the price.
STRIPE_SECRET_KEY=
# Test-mode price IDs. Map a Checkout price to a tier. Replace with live prices before launch.
# Plus (1 Mac): price_1UfrRNFQA2wOQUo52ZVB9O0z
# Pro (2 Macs): price_1UfrRPFQA2wOQUo5QQnUjlGk
# Family (5 Macs): price_1UfrRQFQA2wOQUo5CqAgSdqE
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FAMILY=
# Resend API key. License emails are sent from noreply@tryuncloud.com.
RESEND_API_KEY=
# Checkout URLs belong on the marketing site (Vercel project uncloud), not here:
# UNCLOUD_CHECKOUT_PLUS_URL, UNCLOUD_CHECKOUT_PRO_URL, UNCLOUD_CHECKOUT_FAMILY_URL
# Test payment links:
# https://buy.stripe.com/test_5kQ28r5RY9448P64A4c3m00
# https://buy.stripe.com/test_bJe28r1BI3JKaXe7Mgc3m01
# https://buy.stripe.com/test_28E28rfsy6VW7L24A4c3m02
