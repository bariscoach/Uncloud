# Names only. Real values go in the Vercel project (Production), never in this repo.
# Supabase project URL, publishable key (public) and secret key (server only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Ed25519 private key, PKCS#8 DER, base64. Signs the entitlement the app verifies.
ENTITLEMENT_SIGNING_KEY=
# Optional. Comma-separated origins allowed to post the launch list.
# Default includes https://www.tryuncloud.com, https://tryuncloud.com, and the older Vercel hosts.
WAITLIST_ALLOWED_ORIGINS=
# The license verify and payment webhook stubs do not read a secret.
# Checkout URLs belong on the marketing site (Vercel project uncloud), not here:
# UNCLOUD_CHECKOUT_PLUS_URL, UNCLOUD_CHECKOUT_PRO_URL, UNCLOUD_CHECKOUT_FAMILY_URL
