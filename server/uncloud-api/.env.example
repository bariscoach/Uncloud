# Names only. Real values go in the Vercel project (Production), never in this repo.
# Supabase project URL, publishable key (public) and secret key (server only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Ed25519 private key, PKCS#8 DER, base64. Signs the entitlement the app verifies.
ENTITLEMENT_SIGNING_KEY=
# Optional. Comma-separated origins allowed to post the launch list. Default https://uncloud-app.vercel.app
WAITLIST_ALLOWED_ORIGINS=
